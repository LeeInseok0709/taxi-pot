<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/taxipot_surface"
    android:orientation="vertical">

    <!-- 상단 바: 뒤로 가기 + 경로 (백석대 → 천안역) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="20dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_back"
            android:tint="@color/taxipot_text" />

        <TextView
            android:id="@+id/tvTitle"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="대기실"
            android:textColor="@color/taxipot_text"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp">

            <!-- 집결까지 남은 시간 · 방 상태 -->
            <TextView
                android:id="@+id/tvChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:textColor="@color/taxipot_text"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- 지도: 집결지(출발지) -->
            <FrameLayout
                android:id="@+id/mapCard"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="16dp"
                android:padding="1dp">

                <com.kakao.vectormap.MapView
                    android:id="@+id/mapView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>

            <!-- 참여자 · 좌석 · 도착 현황 -->
            <LinearLayout
                android:id="@+id/membersCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- 참여자 줄은 코드에서 채움 -->
                <LinearLayout
                    android:id="@+id/membersContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="빈자리"
                        android:textColor="@color/taxipot_sub_text"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/tvVacancy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/taxipot_text"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 방 수정 / 채팅 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnEdit"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:gravity="center"
                    android:text="방 수정"
                    android:textColor="@color/taxipot_text"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btnChat"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="채팅"
                    android:textColor="@color/taxipot_text"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 방 취소(참여 취소) / 입장 요청 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnCancel"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:gravity="center"
                    android:text="방 취소"
                    android:textColor="@color/taxipot_text"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btnJoinRequests"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="입장 요청"
                    android:textColor="@color/taxipot_text"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 안내 -->
            <TextView
                android:id="@+id/tvInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:padding="12dp"
                android:text="ⓘ 도착 확인은 GPS 반경 50m 이내에서 가능합니다."
                android:textColor="@color/taxipot_sub_text"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

    <!-- 아래 고정: 도착 확인 / 탑승 시작(방장) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/btnArrive"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="도착 확인 (50m 이내)"
            android:textColor="@color/taxipot_text"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="탑승 시작 (전원 도착 시)"
            android:textColor="@color/taxipot_text"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>