<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FBF7F0"
    android:orientation="vertical">

    <!-- 상단 바: 뒤로 가기 + 좌석 선택하기 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="20dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_back"
            android:tint="#2B2B2B" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="좌석 선택하기"
            android:textColor="#2B2B2B"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="희망 좌석을 선택하세요"
                android:textColor="#2B2B2B"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- 자동차 모양: 앞줄(운전석·조수석) / 뒷줄(왼쪽·가운데·오른쪽) -->
            <LinearLayout
                android:id="@+id/carCard"
                android:layout_width="240dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="22dp"
                android:paddingEnd="18dp"
                android:paddingBottom="22dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/seatDriver"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="운전석"
                        android:textColor="#9A9A9A"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/seatFront"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:gravity="center"
                        android:text="조수석"
                        android:textColor="#2B2B2B"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/seatBackLeft"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="뒤 왼쪽"
                        android:textColor="#2B2B2B"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/seatBackMid"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:gravity="center"
                        android:text="뒤 가운데"
                        android:textColor="#2B2B2B"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/seatBackRight"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:gravity="center"
                        android:text="뒤 오른쪽"
                        android:textColor="#2B2B2B"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 상관없음 -->
            <TextView
                android:id="@+id/seatNone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="상관없음"
                android:textColor="#2B2B2B"
                android:textSize="14sp" />

            <!-- 예치액 카드 (요금을 아직 안 넣었으면 숨김) -->
            <LinearLayout
                android:id="@+id/moneyCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="예치액"
                        android:textColor="#6B6B6B"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/tvHoldValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#2B2B2B"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="(예상요금 × 1.2 ÷ 인원 + 수수료 1,000)"
                    android:textColor="#9A9A9A"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="예치 후 잔액"
                        android:textColor="#6B6B6B"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/tvAfterBalance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#2B2B2B"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- 아래 고정: 지정하기 -->
    <TextView
        android:id="@+id/btnConfirm"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="12dp"
        android:gravity="center"
        android:text="지정하기"
        android:textColor="#2B2B2B"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>