<?xml version="1.0" encoding="utf-8"?>
<!-- 출금 계좌 관리 (AC-01의 메뉴) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/taxipot_surface"
    android:orientation="vertical">

    <include
        android:id="@+id/appBar"
        layout="@layout/view_taxipot_app_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_taxipot_box"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="지금 등록된 계좌"
                    android:textColor="@color/taxipot_sub_text"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvCurrent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="불러오는 중..."
                    android:textColor="@color/taxipot_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                style="@style/TaxiPot.Label"
                android:layout_marginTop="20dp"
                android:text="은행" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilBank"
                style="@style/TaxiPot.Field"
                app:endIconDrawable="@drawable/ic_arrow_drop_down"
                app:endIconMode="custom">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etBank"
                    style="@style/TaxiPot.FieldEdit.Select"
                    android:hint="은행 선택" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/TaxiPot.Label"
                android:text="계좌번호" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilAccountNumber"
                style="@style/TaxiPot.Field">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etAccountNumber"
                    style="@style/TaxiPot.FieldEdit"
                    android:digits="0123456789-"
                    android:hint="계좌번호 입력"
                    android:inputType="number"
                    android:maxLength="20" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/TaxiPot.Label"
                android:text="예금주" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilHolder"
                style="@style/TaxiPot.Field"
                app:helperText="가입한 이름과 같은 명의의 계좌만 등록할 수 있어요.">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etHolder"
                    style="@style/TaxiPot.FieldEdit.Select"
                    android:hint="이름과 동일" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/TaxiPot.Label"
                android:layout_marginTop="20dp"
                android:text="현재 비밀번호" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPassword"
                style="@style/TaxiPot.Field" app:endIconMode="password_toggle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPassword"
                    style="@style/TaxiPot.FieldEdit"
                    android:hint="계좌를 바꾸려면 비밀번호를 입력해 주세요"
                    android:inputType="textPassword" />
            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            style="@style/TaxiPot.PrimaryButton"
            android:text="계좌 변경" />
    </FrameLayout>
</LinearLayout>
