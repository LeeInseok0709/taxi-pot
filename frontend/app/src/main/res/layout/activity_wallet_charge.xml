<?xml version="1.0" encoding="utf-8"?>
<!-- WL-02 충전하기 (Figma: 06 내 지갑 1/2 · 충전 / ANDROID). 결제 수단 대신 등록한 충전 계좌 표시 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/taxipot_surface"
    android:orientation="vertical">

    <include
        android:id="@+id/appBar"
        layout="@layout/view_taxipot_app_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <!-- 충전 금액 -->
            <TextView
                style="@style/TaxiPot.Label"
                android:layout_marginTop="0dp"
                android:text="충전 금액 (원)" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilAmount"
                style="@style/TaxiPot.Field">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etAmount"
                    style="@style/TaxiPot.FieldEdit"
                    android:hint="충전할 금액 입력"
                    android:imeOptions="actionDone"
                    android:inputType="number"
                    android:maxLength="7" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 빠른 금액 추가 (1회 최대 5만 원이라 +1·2·3·5만) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnAdd1"
                    style="@style/TaxiPot.Option"
                    android:foreground="?attr/selectableItemBackground"
                    android:text="+1만"
                    android:textSize="13sp" />

                <Space
                    android:layout_width="8dp"
                    android:layout_height="0dp" />

                <TextView
                    android:id="@+id/btnAdd2"
                    style="@style/TaxiPot.Option"
                    android:foreground="?attr/selectableItemBackground"
                    android:text="+2만"
                    android:textSize="13sp" />

                <Space
                    android:layout_width="8dp"
                    android:layout_height="0dp" />

                <TextView
                    android:id="@+id/btnAdd3"
                    style="@style/TaxiPot.Option"
                    android:foreground="?attr/selectableItemBackground"
                    android:text="+3만"
                    android:textSize="13sp" />

                <Space
                    android:layout_width="8dp"
                    android:layout_height="0dp" />

                <TextView
                    android:id="@+id/btnAdd5"
                    style="@style/TaxiPot.Option"
                    android:foreground="?attr/selectableItemBackground"
                    android:text="+5만"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 금액 요약 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_taxipot_box"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="충전 금액"
                        android:textColor="@color/taxipot_sub_text"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvSumAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/taxipot_text"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowDebt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="미수금 자동 차감"
                        android:textColor="@color/taxipot_sub_text"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvSumDebt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/taxipot_text"
                        android:textSize="14sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:background="@color/taxipot_line" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="실제 충전"
                        android:textColor="@color/taxipot_text"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvSumActual"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/taxipot_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- 안내 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:padding="2dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginTop="1dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_info_outline"
                    app:tint="@color/taxipot_text" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="미수금이 있으면 충전 금액에서 먼저 빠져나가고 남은 금액이 지갑에 충전됩니다."
                    android:textColor="@color/taxipot_sub_text"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 충전 계좌 (등록한 본인 계좌, 누르면 계좌 변경) -->
            <LinearLayout
                android:id="@+id/cardAccount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_taxipot_box"
                android:foreground="?attr/selectableItemBackground"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="충전 계좌"
                    android:textColor="@color/taxipot_sub_text"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvAccount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="불러오는 중..."
                        android:textColor="@color/taxipot_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/chipDefault"
                        style="@style/TaxiPot.Chip"
                        android:layout_marginStart="8dp"
                        android:text="기본 계좌"
                        android:visibility="gone" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="4dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/taxipot_sub_text" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvAccountHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/taxipot_sub_text"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- 충전하기 (화면 아래 고정) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPay"
            style="@style/TaxiPot.PrimaryButton"
            android:text="충전하기" />
    </FrameLayout>
</LinearLayout>
