<?xml version="1.0" encoding="utf-8"?>
<!-- AU-02 이메일 인증 (Figma: 01 회원가입 · 학생 인증 / ANDROID) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/taxipot_surface"
    android:orientation="vertical">

    <include
        android:id="@+id/appBar"
        layout="@layout/view_taxipot_app_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <TextView
                style="@style/TaxiPot.Chip"
                android:text="1차 인증 · 이메일 코드" />

            <TextView
                style="@style/TaxiPot.Title"
                android:layout_marginTop="16dp"
                android:text="학교 메일을 확인해주세요" />

            <TextView
                style="@style/TaxiPot.Desc"
                android:text="학교 메일로 인증코드를 보냈습니다." />

            <!-- 받는 메일 (가려서 표시) -->
            <TextView
                android:id="@+id/tvEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/taxipot_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- 인증코드 -->
            <TextView
                style="@style/TaxiPot.Label"
                android:layout_marginTop="24dp"
                android:text="인증코드" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCode"
                style="@style/TaxiPot.Field">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCode"
                    style="@style/TaxiPot.FieldEdit"
                    android:hint="인증코드 6자리 입력"
                    android:imeOptions="actionDone"
                    android:inputType="number"
                    android:maxLength="10" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 남은 시간 -->
            <TextView
                android:id="@+id/tvRemaining"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:paddingStart="4dp"
                android:textColor="@color/taxipot_sub_text"
                android:textSize="12sp" />

            <!-- 재발송 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResend"
                style="@style/TaxiPot.OutlineButton"
                android:layout_marginTop="20dp"
                android:text="인증코드 재발송" />

            <!-- 안내 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_taxipot_box"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_info_outline"
                    app:tint="@color/taxipot_text" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="메일을 받지 못했다면 스팸 메일함을 확인해주세요."
                    android:textColor="@color/taxipot_sub_text"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- 확인 버튼 (화면 아래 고정) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirm"
            style="@style/TaxiPot.PrimaryButton"
            android:text="확인" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:elevation="8dp"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="@color/taxipot_text"
            app:indicatorSize="24dp"
            app:trackThickness="3dp" />
    </FrameLayout>
</LinearLayout>
