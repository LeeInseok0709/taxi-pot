<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/taxipot_surface"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_back"
            android:tint="@color/taxipot_text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="실요금 청구"
            android:textColor="@color/taxipot_text"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvRoute"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/taxipot_sub_text"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="결제내역 사진"
                android:textColor="@color/taxipot_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <FrameLayout
                android:id="@+id/photoBox"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tvPhotoHint"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="눌러서 사진 고르기\n(카카오 T·우버 결제 화면 캡처나 영수증)"
                    android:textColor="@color/taxipot_sub_text"
                    android:textSize="13sp" />

                <ImageView
                    android:id="@+id/ivReceipt"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerInside"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="실제 요금 (원)"
                android:textColor="@color/taxipot_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etFare"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:hint="예: 9800"
                android:inputType="number"
                android:maxLength="6"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/taxipot_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:lineSpacingExtra="3dp"
                android:padding="14dp"
                android:text="ⓘ 운영자가 사진과 금액을 확인하면 정산돼요.\n탑승자는 실요금 ÷ 인원 + 수수료 1,000원을 내고, 예치금의 남는 돈은 돌려받아요."
                android:textColor="@color/taxipot_sub_text"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/btnSubmit"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_margin="20dp"
        android:gravity="center"
        android:text="청구하기"
        android:textColor="@color/taxipot_text"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>