<?xml version="1.0" encoding="utf-8"?>
<!-- AC-05 탈퇴 완료 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/taxipot_surface"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/bg_taxipot_circle_primary"
            android:importantForAccessibility="no"
            android:padding="22dp"
            android:src="@drawable/ic_check"
            app:tint="@color/taxipot_text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="탈퇴가 완료되었습니다"
            android:textColor="@color/taxipot_text"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="그동안 택시팟을 이용해 주셔서 감사합니다.\n개인정보는 14일 뒤 파기돼요."
            android:textColor="@color/taxipot_sub_text"
            android:textSize="14sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStart"
            style="@style/TaxiPot.PrimaryButton"
            android:text="처음으로" />
    </FrameLayout>
</LinearLayout>
