<?xml version="1.0" encoding="utf-8"?>
<!-- AU-04 인증 상태 (로그인 후 인증이 덜 끝난 사람도 여기서 남은 단계로 이동) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/taxipot_surface"
    android:orientation="vertical">

    <include
        android:id="@+id/appBar"
        layout="@layout/view_taxipot_app_bar" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="8dp"
                android:paddingEnd="20dp"
                android:paddingBottom="24dp">

                <!-- 불러오기 실패 안내 -->
                <TextView
                    android:id="@+id/tvError"
                    style="@style/TaxiPot.ErrorText"
                    android:layout_marginTop="0dp"
                    android:layout_marginBottom="12dp"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="invisible">

                    <TextView
                        android:id="@+id/tvTitle"
                        style="@style/TaxiPot.Title"
                        android:text="학생 인증이 진행 중이에요" />

                    <!-- 1차: 이메일 인증 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/bg_taxipot_box"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvEmailChip"
                            style="@style/TaxiPot.Chip" />

                        <TextView
                            android:id="@+id/tvEmailDesc"
                            style="@style/TaxiPot.Desc"
                            android:layout_marginTop="10dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnEmailAction"
                            style="@style/TaxiPot.OutlineButton"
                            android:layout_marginTop="12dp"
                            android:text="이메일 인증하기"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- 2차: 운영자 심사 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_taxipot_box"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvReviewChip"
                            style="@style/TaxiPot.Chip" />

                        <TextView
                            android:id="@+id/tvReviewDesc"
                            style="@style/TaxiPot.Desc"
                            android:layout_marginTop="10dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnReviewAction"
                            style="@style/TaxiPot.OutlineButton"
                            android:layout_marginTop="12dp"
                            android:text="캡처본 제출하기"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- 이용 제한 안내 (승인 전까지) -->
                    <LinearLayout
                        android:id="@+id/boxLocked"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_taxipot_box"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_lock_outline"
                            app:tint="@color/taxipot_text" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="심사 완료 전에는 택시팟 생성 · 참여가 제한됩니다."
                            android:textColor="@color/taxipot_sub_text"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- 운영자 승인 후 상태 다시 확인 -->
                    <TextView
                        android:id="@+id/tvRefresh"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:padding="8dp"
                        android:text="상태 새로고침"
                        android:textColor="@color/taxipot_sub_text"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="@color/taxipot_text"
            app:indicatorSize="32dp"
            app:trackThickness="3dp" />
    </FrameLayout>

    <!-- 홈으로 (화면 아래 고정) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHome"
            style="@style/TaxiPot.PrimaryButton"
            android:text="둘러보기 (홈으로)" />
    </FrameLayout>
</LinearLayout>
