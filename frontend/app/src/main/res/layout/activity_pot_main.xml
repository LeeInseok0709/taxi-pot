<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/taxipot_surface"
    android:orientation="vertical">

    <!-- 상단 바: 택시 아이콘 + 택시팟 + 알림 (지갑·마이페이지 상단과 같은 구조) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="8dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_taxi"
            android:tint="@color/taxipot_text" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="택시팟"
            android:textColor="@color/taxipot_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- 알림 종 + 안 읽은 알림 점 -->
        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp">

            <ImageButton
                android:id="@+id/btnBell"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="알림"
                android:src="@drawable/ic_bell"
                android:tint="@color/taxipot_text" />

            <View
                android:id="@+id/viewBellDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="11dp"
                android:background="@drawable/bg_taxipot_dot"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- 장소 검색 제목 + 잔액 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="장소 검색"
            android:textColor="@color/taxipot_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvBalance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="-P"
            android:textColor="@color/taxipot_text"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 검색창 (모양만, 기능은 나중에) -->
    <TextView
        android:id="@+id/tvSearch"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="20dp"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="지하철역 · 장소 검색"
        android:textColor="@color/taxipot_sub_text"
        android:textSize="14sp" />

    <!-- 지도 카드 + 현위치 버튼 -->
    <FrameLayout
        android:id="@+id/mapCard"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="20dp"
        >

        <com.kakao.vectormap.MapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
        <!-- 지도 모서리를 둥글게 덮기 -->
        <com.example.taxipot.feature.pot.main.MapCornerMask
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageView
            android:id="@+id/btnMyLocation"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="10dp"
            android:padding="9dp"
            android:src="@drawable/ic_my_location"
            android:tint="@color/taxipot_text" />
    </FrameLayout>

    <!-- 내가 참여 중인 택시팟 (있을 때만, 누르면 대기실) -->
    <TextView
        android:id="@+id/tvMyPot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:padding="14dp"
        android:textColor="@color/taxipot_text"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- 목록 제목 -->
    <TextView
        android:id="@+id/tvNearbyTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="8dp"
        android:text="내 주변 모집 중 택시팟 0"
        android:textColor="@color/taxipot_text"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- 주변에 방이 없을 때 -->
    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="이 주변에 모집 중인 택시팟이 없어요\n아래 '방 만들기'로 직접 모아 보세요!"
        android:textColor="@color/taxipot_sub_text"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- 방 카드 목록 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPots"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingEnd="20dp" />

    <!-- 방 만들기 버튼 -->
    <TextView
        android:id="@+id/btnCreatePot"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="12dp"
        android:gravity="center"
        android:text="+ 방 만들기"
        android:textColor="@color/taxipot_text"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- 하단 메뉴 위 구분선 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/taxipot_muted" />

    <!-- 하단 메뉴 (모양만) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivNavHome"
                android:layout_width="48dp"
                android:layout_height="28dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:src="@drawable/ic_home"
                android:tint="@color/taxipot_text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="홈 화면"
                android:textColor="@color/taxipot_text"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navWallet"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="28dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:src="@drawable/ic_wallet"
                android:tint="@color/taxipot_sub_text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="내 지갑"
                android:textColor="@color/taxipot_sub_text"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navMy"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="28dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:src="@drawable/ic_person"
                android:tint="@color/taxipot_sub_text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="마이페이지"
                android:textColor="@color/taxipot_sub_text"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>