<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialogRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="잔액이 부족합니다"
        android:textColor="@color/taxipot_text"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="예치에 필요한 포인트를 충전해주세요."
        android:textColor="@color/taxipot_sub_text"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="필요 예치액"
            android:textColor="@color/taxipot_sub_text"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/tvRequired"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/taxipot_text"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="현재 잔액"
            android:textColor="@color/taxipot_sub_text"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/tvBalance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/taxipot_text"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="부족 금액"
            android:textColor="@color/taxipot_sub_text"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/tvShortage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/taxipot_text"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 버튼: 닫기 / 충전하기 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnClose"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="닫기"
            android:textColor="@color/taxipot_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btnCharge"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:gravity="center"
            android:text="충전하기"
            android:textColor="@color/taxipot_text"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 참여 불가 사유별 안내 -->
    <LinearLayout
        android:id="@+id/reasonCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ⓘ 참여 불가 사유별 안내"
            android:textColor="@color/taxipot_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="3dp"
            android:text="정지 중 / 인증 미완료\n진행 중 방 존재 / 성별 제한\n모집 마감 / 미수금 미납\n참여 마감 → 입장 요청"
            android:textColor="@color/taxipot_sub_text"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>