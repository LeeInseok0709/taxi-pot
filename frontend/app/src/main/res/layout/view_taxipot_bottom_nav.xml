<?xml version="1.0" encoding="utf-8"?>
<!-- 공통 하단 메뉴: 선택 표시·이동은 core/ui/TaxiPotBottomNav.setup()이 처리 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/taxipot_surface"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/taxipot_line" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivNavHome"
                android:layout_width="48dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:src="@drawable/ic_home" />

            <TextView
                android:id="@+id/tvNavHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="홈 화면"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navWallet"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivNavWallet"
                android:layout_width="48dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:src="@drawable/ic_wallet" />

            <TextView
                android:id="@+id/tvNavWallet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="내 지갑"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navMy"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivNavMy"
                android:layout_width="48dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:src="@drawable/ic_person" />

            <TextView
                android:id="@+id/tvNavMy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="마이페이지"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
