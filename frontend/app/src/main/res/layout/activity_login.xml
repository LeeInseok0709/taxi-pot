<?xml version="1.0" encoding="utf-8"?>
<!-- 로그인 화면: Figma AU-01 회원가입 화면과 같은 스타일 (라벨 위 + 입력 상자 52dp + 베이지 버튼) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/taxipot_surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <!-- 머리말 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="택시팟 · 백석대학교"
            android:textColor="@color/taxipot_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="같이 타면 반값, 택시팟"
            android:textColor="@color/taxipot_text"
            android:textSize="23sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="학교 이메일로 로그인해주세요."
            android:textColor="@color/taxipot_sub_text"
            android:textSize="14sp" />

        <!-- 학교 이메일 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="학교 이메일"
            android:textColor="@color/taxipot_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEmail"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            app:boxBackgroundColor="@color/taxipot_surface"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/taxipot_field_stroke"
            app:boxStrokeErrorColor="@color/taxipot_error"
            app:boxStrokeWidth="1dp"
            app:boxStrokeWidthFocused="1.5dp"
            app:errorTextColor="@color/taxipot_error"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="학교 메일 주소 입력"
                android:imeOptions="actionNext"
                android:inputType="textEmailAddress"
                android:maxLines="1"
                android:paddingStart="14dp"
                android:paddingTop="0dp"
                android:paddingEnd="14dp"
                android:paddingBottom="0dp"
                android:textColor="@color/taxipot_text"
                android:textColorHint="@color/taxipot_sub_text"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 비밀번호 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="비밀번호"
            android:textColor="@color/taxipot_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPassword"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            app:boxBackgroundColor="@color/taxipot_surface"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/taxipot_field_stroke"
            app:boxStrokeErrorColor="@color/taxipot_error"
            app:boxStrokeWidth="1dp"
            app:boxStrokeWidthFocused="1.5dp"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/taxipot_sub_text"
            app:errorTextColor="@color/taxipot_error"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="비밀번호 입력"
                android:imeOptions="actionDone"
                android:inputType="textPassword"
                android:maxLines="1"
                android:paddingStart="14dp"
                android:paddingTop="0dp"
                android:paddingEnd="14dp"
                android:paddingBottom="0dp"
                android:textColor="@color/taxipot_text"
                android:textColorHint="@color/taxipot_sub_text"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 로그인 실패·연결 실패 안내 -->
        <TextView
            android:id="@+id/tvError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/taxipot_error"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- 로그인 버튼 + 로딩 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="로그인"
                android:textColor="@color/taxipot_text"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@color/taxipot_primary"
                app:cornerRadius="12dp" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:elevation="8dp"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="@color/taxipot_text"
                app:indicatorSize="24dp"
                app:trackThickness="3dp" />
        </FrameLayout>

        <!-- 회원가입 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="아직 계정이 없나요?"
                android:textColor="@color/taxipot_sub_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvSignup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:padding="6dp"
                android:text="회원가입"
                android:textColor="@color/taxipot_text"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
