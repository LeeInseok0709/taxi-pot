# 이 파일을 복사해서 application-local.yml로 이름을 바꾸고 값을 채운다.
# application-local.yml은 .gitignore에 있어서 깃에 올라가지 않는다.
spring:
  datasource:
    username: root
    password: 여기에_내_MySQL_비밀번호
  jpa:
    show-sql: true

app:
  upload-dir: ./uploads
  jwt:
    # 팀 공용 개발용 값은 카톡/노션으로만 공유 (32자 이상)
    secret: 여기에_팀_공용_JWT_시크릿_32자_이상
  crypto:
    # 팀 전원이 같은 값을 써야 서로의 DB 덤프를 읽을 수 있다
    # 생성: openssl rand -base64 32
    aes-key: 여기에_팀_공용_Base64_32바이트_키
  auth:
    debug-header-enabled: true     # JWT 완성 전: Swagger에서 X-Debug-User-Id로 로그인 흉내
  cors:
    allowed-origins:
      - http://localhost:5173      # 운영자 웹을 따로 띄울 때만
  scheduler:
    enabled: true                  # API만 테스트할 땐 false
